# Skips the Bloxity SDK (sdk.bloxity.io) and avatar CDN (static.bloxity.io) so local dev never depends on them.
VITE_DEV_MODE=false

# Colyseus server (../Kayak-and-surf -backend), one URL per Bloxity Legion channel.
# `npm run dev` / `build:dev` use _DEV (npm run dev defaults to ws://localhost:2567); `npm run build` uses _MAIN.
# Leave a URL empty to let the Bloxity SDK resolve that channel's endpoint at runtime.
VITE_SERVER_URL_DEV=
VITE_SERVER_URL_MAIN=

# Daily rewards (config DAILY_REWARDS): length of a "day" in ms, e.g. 60000 to test the calendar. Leave empty for 24 h.
VITE_DAILY_DAY_MS=
